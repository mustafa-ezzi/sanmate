# How to create/find every key below: docs/CREDENTIALS_SETUP.md
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty to use SQLite (db.sqlite3). For Postgres:
# DATABASE_URL=postgres://user:pass@localhost:5432/sams

# Cloudflare R2 (S3-compatible) — same bucket, company-prefixed keys
# Create R2 API tokens in Cloudflare dashboard → R2 → Manage R2 API Tokens
CF_ACCOUNT_ID=
CF_R2_BUCKET=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
# Public base URL (R2 custom domain or r2.dev public bucket URL), no trailing slash
# Example: https://media.yourdomain.com  or  https://pub-xxxxx.r2.dev
CF_MEDIA_BASE_URL=
# Legacy alias (unused for uploads; kept for older docs)
CF_API_TOKEN=

# Rapid Gateway (Pakistan) — cards, JazzCash, easypaisa, Raast
# Docs: https://rapidgateway.pk/  ·  setup: docs/CREDENTIALS_SETUP.md
RAPID_GATEWAY_ENV=test
RAPID_GATEWAY_SECRET_KEY=
RAPID_GATEWAY_PUBLIC_KEY=
RAPID_GATEWAY_MERCHANT_ID=
RAPID_GATEWAY_API_BASE=https://api.rapidgateway.pk/v1
RAPID_GATEWAY_WEBHOOK_SECRET=
# Public storefront URL for payment return (Railway frontend URL)
# STOREFRONT_BASE_URL=https://your-frontend.up.railway.app
# Without secret key + DEBUG=True → checkout can simulate payment locally

# WhatsApp Cloud API (Meta) — fan-out to each recipient in admin Settings
WHATSAPP_SAMS_NOTIFY_TO=03363399445,03000000001,03000000002,03000000003
WHATSAPP_AM_NOTIFY_TO=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required for real delivery. Without token + phone id, sends are STUB-only (not on WhatsApp).
# For cold order alerts, create an approved Meta template and set:
# WHATSAPP_TEMPLATE_NAME=order_alert
# WHATSAPP_TEMPLATE_LANG=en
# Template body vars expected: {{1}}=order number, {{2}}=customer name, {{3}}=total
